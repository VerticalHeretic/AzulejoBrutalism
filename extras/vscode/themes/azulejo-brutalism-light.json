    "selection.background": "#9FB2E499",
    "widget.border": "#C9C5B9",
    "sash.hoverBorder": "#1E2A9E",
    "textLink.foreground": "#1E2A9E",
    "textLink.activeForeground": "#1E2A9E",
    "button.background": "#1E2A9E",
    "button.foreground": "#F3F0E8",
    "button.hoverBackground": "#1E2A9E",
    "button.secondaryBackground": "#DEDAD0",
    "button.secondaryForeground": "#0C1030",
    "badge.background": "#1E2A9E",
    "badge.foreground": "#F3F0E8",
    "activityBarBadge.background": "#D49A1A",
    "activityBarBadge.foreground": "#0C1030",
    "input.background": "#F3F0E8",
    "input.border": "#C9C5B9",
    "input.foreground": "#0C1030",
    "input.placeholderForeground": "#8A8DA3",
    "inputOption.activeBorder": "#1E2A9E",
    "dropdown.background": "#E8E4D9",
    "dropdown.border": "#C9C5B9",
    "checkbox.background": "#F3F0E8",
    "checkbox.border": "#C9C5B9",
    "scrollbarSlider.background": "#5A5E784C",
    "scrollbarSlider.hoverBackground": "#5A5E7880",
    "scrollbarSlider.activeBackground": "#5A5E78B2",
    "progressBar.background": "#1E2A9E",
    "list.activeSelectionBackground": "#1E2A9E",
    "list.activeSelectionForeground": "#F3F0E8",
    "list.inactiveSelectionBackground": "#D6DAE7",
    "list.inactiveSelectionForeground": "#0C1030",
    "list.hoverBackground": "#DEDAD0",
    "list.focusOutline": "#1E2A9E",
    "list.highlightForeground": "#1E2A9E",
    "activityBar.background": "#E8E4D9",
    "activityBar.foreground": "#0C1030",
    "activityBar.inactiveForeground": "#8A8DA3",
    "activityBar.activeBorder": "#D49A1A",
    "activityBar.border": "#C9C5B9",
    "sideBar.background": "#E8E4D9",
    "sideBar.foreground": "#0C1030",
    "sideBar.border": "#C9C5B9",
    "sideBarTitle.foreground": "#0C1030",
    "sideBarSectionHeader.background": "#E8E4D9",
    "sideBarSectionHeader.border": "#C9C5B9",
    "editorGroup.border": "#0C1030",
    "editorGroupHeader.tabsBackground": "#E8E4D9",
    "editorGroupHeader.tabsBorder": "#C9C5B9",
    "tab.activeBackground": "#F3F0E8",
    "tab.activeForeground": "#0C1030",
    "tab.activeBorderTop": "#D49A1A",
    "tab.inactiveBackground": "#E8E4D9",
    "tab.inactiveForeground": "#5A5E78",
    "tab.border": "#C9C5B9",
    "titleBar.activeBackground": "#E8E4D9",
    "titleBar.activeForeground": "#0C1030",
    "titleBar.inactiveBackground": "#E8E4D9",
    "titleBar.inactiveForeground": "#5A5E78",
    "titleBar.border": "#C9C5B9",
    "statusBar.background": "#E8E4D9",
    "statusBar.foreground": "#0C1030",
    "statusBar.border": "#C9C5B9",
    "statusBar.debuggingBackground": "#D49A1A",
    "statusBar.debuggingForeground": "#0C1030",
    "statusBar.noFolderBackground": "#E8E4D9",
    "statusBarItem.remoteBackground": "#1E2A9E",
    "statusBarItem.remoteForeground": "#F3F0E8",
    "panel.background": "#F3F0E8",
    "panel.border": "#0C1030",
    "panelTitle.activeBorder": "#D49A1A",
    "panelTitle.activeForeground": "#0C1030",
    "panelTitle.inactiveForeground": "#5A5E78",
    "editor.background": "#F3F0E8",
    "editor.foreground": "#0C1030",
    "editorLineNumber.foreground": "#8A8DA3",
    "editorLineNumber.activeForeground": "#D49A1A",
    "editorCursor.foreground": "#D49A1A",
    "editor.selectionBackground": "#9FB2E499",
    "editor.inactiveSelectionBackground": "#9FB2E44C",
    "editor.selectionHighlightBackground": "#9FB2E44C",
    "editor.wordHighlightBackground": "#9FB2E44C",
    "editor.wordHighlightStrongBackground": "#9FB2E473",
    "editor.findMatchBackground": "#D49A1AB2",
    "editor.findMatchHighlightBackground": "#D49A1A59",
    "editor.lineHighlightBackground": "#E8E4D9",
    "editor.lineHighlightBorder": "#00000000",
    "editorWhitespace.foreground": "#D2CEC3",
    "editorIndentGuide.background1": "#DEDAD0",
    "editorIndentGuide.activeBackground1": "#5A5E78",
    "editorRuler.foreground": "#DEDAD0",
    "editorBracketMatch.background": "#9FB2E466",
    "editorBracketMatch.border": "#1E2A9E",
    "editorWidget.background": "#E8E4D9",
    "editorWidget.border": "#C9C5B9",
    "editorSuggestWidget.background": "#E8E4D9",
    "editorSuggestWidget.border": "#C9C5B9",
    "editorSuggestWidget.selectedBackground": "#1E2A9E",
    "editorSuggestWidget.selectedForeground": "#F3F0E8",
    "editorSuggestWidget.highlightForeground": "#1E2A9E",
    "editorHoverWidget.background": "#E8E4D9",
    "editorHoverWidget.border": "#C9C5B9",
    "editorError.foreground": "#B03A2E",
    "editorWarning.foreground": "#8F6200",
    "editorInfo.foreground": "#1E2A9E",
    "editorHint.foreground": "#1D6E7E",
    "editorGutter.addedBackground": "#2F6B3A",
    "editorGutter.modifiedBackground": "#1E2A9E",
    "editorGutter.deletedBackground": "#B03A2E",
    "diffEditor.insertedTextBackground": "#2F6B3A2E",
    "diffEditor.removedTextBackground": "#B03A2E2E",
    "gitDecoration.modifiedResourceForeground": "#1E2A9E",
    "gitDecoration.untrackedResourceForeground": "#2F6B3A",
    "gitDecoration.deletedResourceForeground": "#B03A2E",
    "gitDecoration.ignoredResourceForeground": "#8A8DA3",
    "gitDecoration.conflictingResourceForeground": "#D49A1A",
    "peekView.border": "#1E2A9E",
    "peekViewEditor.background": "#E8E4D9",
    "peekViewResult.background": "#E8E4D9",
    "terminal.background": "#F3F0E8",
    "terminal.foreground": "#0C1030",
    "terminalCursor.foreground": "#D49A1A",
    "terminal.selectionBackground": "#9FB2E499",
    "breadcrumb.foreground": "#5A5E78",
    "breadcrumb.focusForeground": "#0C1030",
    "quickInput.background": "#E8E4D9",
    "quickInputList.focusBackground": "#1E2A9E",
    "quickInputList.focusForeground": "#F3F0E8",
    "notifications.background": "#E8E4D9",
    "notifications.border": "#C9C5B9",
    "menu.background": "#E8E4D9",
    "menu.selectionBackground": "#1E2A9E",
    "menu.selectionForeground": "#F3F0E8",
    "terminal.ansiBlack": "#0C1030",
    "terminal.ansiBrightBlack": "#5A5E78",
    "terminal.ansiRed": "#B03A2E",
    "terminal.ansiBrightRed": "#C8513F",
    "terminal.ansiGreen": "#2F6B3A",
    "terminal.ansiBrightGreen": "#3E8A4C",
    "terminal.ansiYellow": "#8F6200",
    "terminal.ansiBrightYellow": "#B07A0C",
    "terminal.ansiBlue": "#1E2A9E",
    "terminal.ansiBrightBlue": "#3A48C4",
    "terminal.ansiMagenta": "#6B2E80",
    "terminal.ansiBrightMagenta": "#8A48A0",
    "terminal.ansiCyan": "#1D6E7E",
    "terminal.ansiBrightCyan": "#2A8C9E",
    "terminal.ansiWhite": "#D8D4C8",
    "terminal.ansiBrightWhite": "#E8E4D9"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5A5E78",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#1E2A9E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#3D4163"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5A5E78"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#2F6B3A"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#1D6E7E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8F6200"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#6B2E80"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#0C1030",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.function",
        "variable.language",
        "entity.other.attribute-name",
        "meta.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#1D6E7E"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#0C1030"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#1E2A9E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#1E2A9E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#0C1030",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#0C1030",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#1E2A9E"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2F6B3A"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#B03A2E"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#1E2A9E"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#B03A2E"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": {
      "foreground": "#1E2A9E",
      "bold": true
    },
    "type": "#6B2E80",
    "class": "#6B2E80",
    "struct": "#6B2E80",
    "enum": "#6B2E80",
    "interface": "#6B2E80",
    "namespace": "#6B2E80",
    "function": {
      "foreground": "#0C1030",
      "bold": true
    },
    "method": {
      "foreground": "#0C1030",
      "bold": true
    },
    "function.defaultLibrary": "#1D6E7E",
    "variable": "#0C1030",
    "parameter": "#3D4163",
    "property": "#0C1030",
    "enumMember": "#8F6200",
    "variable.readonly": "#8F6200",
    "string": "#2F6B3A",
    "number": "#8F6200",
    "comment": {
      "foreground": "#5A5E78",
      "italic": true
    },
    "macro": "#6B2E80",
    "decorator": "#1D6E7E"
  }
}