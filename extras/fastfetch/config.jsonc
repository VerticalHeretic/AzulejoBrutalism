// Azulejo Brutalism logo. $1 (tile) and $2 (rosette) use the terminal's ANSI blue and yellow,
// which the Ghostty theme maps to Cobalt/Ochre in Light and Wash/Ochre in Dark.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/azulejo.txt",
    "color": { "1": "blue", "2": "yellow" },
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "blue", "title": "blue" },
    "separator": "  "
  },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell", "terminal",
    "cpu", "gpu", "memory", "swap",
    { "type": "disk", "key": "Disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery", "key": "Battery", "format": "{capacity} [{status}]" },
    "locale", "break", "colors"
  ]
}
