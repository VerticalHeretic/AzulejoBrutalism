{
  "name": "Azulejo Brutalism Dark",
  "style": "Dark",
  "author": {
    "name": "Łukasz Stachnik"
  },
  "editor": {
    "backgroundColor": "#0C1030",
    "altBackgroundColor": "#141B6B",
    "tintColor": "#D49A1A",
    "tintColor2": "#D49A1A",
    "textColor": "#F3F0E8",
    "toolbarBackgroundColor": "#0C1030",
    "toolbarIconColor": "#F3F0E8",
    "menuItemColor": "#F3F0E8",
    "timeBlockColor": "#F3F0E8",
    "shouldOverwriteFont": true
  },
  "styles": {
    "body": {
      "font": "SFProText-Regular",
      "size": 16,
      "color": "#F3F0E8",
      "lineSpacing": 1.1
    },
    "title1": {
      "font": "SFPro-ExpandedHeavy",
      "size": 28,
      "color": "#F3F0E8"
    },
    "title2": {
      "font": "SFPro-ExpandedHeavy",
      "size": 22,
      "color": "#F3F0E8"
    },
    "title3": {
      "font": "SFPro-ExpandedBold",
      "size": 18,
      "color": "#F3F0E8"
    },
    "title4": {
      "font": "SFPro-ExpandedBold",
      "size": 16,
      "color": "#F3F0E8"
    },
    "title-mark1": {
      "font": "SFPro-ExpandedHeavy",
      "size": 28,
      "color": "#4CF3F0E8"
    },
    "title-mark2": {
      "font": "SFPro-ExpandedHeavy",
      "size": 22,
      "color": "#4CF3F0E8"
    },
    "title-mark3": {
      "font": "SFPro-ExpandedBold",
      "size": 18,
      "color": "#4CF3F0E8"
    },
    "title-mark4": {
      "font": "SFPro-ExpandedBold",
      "size": 16,
      "color": "#4CF3F0E8"
    },
    "bold": {
      "font": "SFProText-Bold"
    },
    "bold-left-mark": {
      "color": "#4CF3F0E8"
    },
    "bold-right-mark": {
      "color": "#4CF3F0E8"
    },
    "italic": {
      "font": "SFProText-RegularItalic"
    },
    "italic-left-mark": {
      "color": "#4CF3F0E8"
    },
    "italic-right-mark": {
      "color": "#4CF3F0E8"
    },
    "boldItalic": {
      "font": "SFProText-BoldItalic"
    },
    "boldItalic-left-mark": {
      "color": "#4CF3F0E8"
    },
    "boldItalic-right-mark": {
      "color": "#4CF3F0E8"
    },
    "code": {
      "font": "Menlo-Regular",
      "size": 15,
      "color": "#F3F0E8",
      "backgroundColor": "#121956",
      "borderRadius": 0,
      "inlineBorder": true,
      "horizontalMargin": 2,
      "leftBorderPadding": 3,
      "rightBorderPadding": 3
    },
    "code-left-backtick": {
      "color": "#4CF3F0E8"
    },
    "code-right-backtick": {
      "color": "#4CF3F0E8"
    },
    "todo": {
      "font": "noteplanstate",
      "size": 16,
      "color": "#F3F0E8",
      "headIndent": 33
    },
    "checked-todo-characters": {
      "font": "noteplanstate",
      "size": 16,
      "headIndent": 33
    },
    "checked": {
      "color": "#7CBF7A",
      "headIndent": 33
    },
    "checked-canceled": {
      "regex": "(^\\h*[\\*\\-\\+]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\-\\] )(.*)",
      "matchPosition": 0,
      "color": "#7A766C",
      "strikethroughStyle": 1,
      "headIndent": 33
    },
    "checked-scheduled": {
      "regex": "(^\\h*[\\*\\-\\+]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\>\\] )(.*)",
      "matchPosition": 0,
      "color": "#66F3F0E8",
      "headIndent": 33
    },
    "working-on": {
      "color": "#F3F0E8",
      "backgroundColor": "#1FF3F0E8"
    },
    "tabbed": {
      "headIndent": 43
    },
    "flagged-1": {
      "color": "#F3F0E8",
      "backgroundColor": "#1AF3F0E8"
    },
    "flagged-2": {
      "color": "#F3F0E8",
      "backgroundColor": "#33F3F0E8"
    },
    "flagged-3": {
      "color": "#F3F0E8",
      "backgroundColor": "#59F3F0E8"
    },
    "quote-mark": {
      "font": "noteplanstate",
      "size": 16,
      "color": "#F3F0E8",
      "headIndent": 33
    },
    "quote-content": {
      "color": "#CCF3F0E8",
      "type": "italic",
      "headIndent": 33
    },
    "link": {},
    "note-title-link": {},
    "schedule-to-date-link": {},
    "schedule-from-date-link": {},
    "done-date": {
      "color": "#66F3F0E8"
    },
    "phonenumber": {},
    "hashtag": {
      "color": "#F3F0E8",
      "backgroundColor": "#121956",
      "borderRadius": 0,
      "inlineBorder": true,
      "horizontalMargin": 2,
      "leftBorderPadding": 3,
      "rightBorderPadding": 3
    },
    "attag": {
      "color": "#F3F0E8",
      "backgroundColor": "#121956",
      "borderRadius": 0,
      "inlineBorder": true,
      "horizontalMargin": 2,
      "leftBorderPadding": 3,
      "rightBorderPadding": 3
    },
    "highlighted": {
      "color": "#0C1030",
      "backgroundColor": "#D49A1A"
    },
    "highlighted-left-marker": {
      "color": "#4CF3F0E8"
    },
    "highlighted-right-marker": {
      "color": "#4CF3F0E8"
    },
    "strikethrough": {
      "color": "#80F3F0E8",
      "strikethroughColor": "#B2F3F0E8"
    },
    "strikethrough-left-tilde": {
      "color": "#4CF3F0E8"
    },
    "strikethrough-right-tilde": {
      "color": "#4CF3F0E8"
    },
    "underline": {
      "underlineStyle": 2,
      "underlineColor": "#D49A1A"
    },
    "underline-left-tilde": {
      "color": "#4CF3F0E8"
    },
    "underline-right-tilde": {
      "color": "#4CF3F0E8"
    }
  }
}
